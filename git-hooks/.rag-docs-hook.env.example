RAG_DOCS_OUTPUT_DIR="docs"

# Вариант 1: простой локальный stub/пример генератора.
# Безопасен только для локальной проверки.
# RAG_DOCS_GENERATE_COMMAND='git-hooks/scripts/rag-docs/generate-rag-docs.example.sh'

# Вариант 2: обёртка для настоящей команды agent skill.
# Обёртка читает и выполняет AGENT_SKILL_COMMAND.
RAG_DOCS_GENERATE_COMMAND='git-hooks/scripts/rag-docs/run-agent-skill.example.sh'

# В целевом проекте замените это настоящим вызовом agent skill.
# Реальная команда будет доступна только в рабочем окружении.
AGENT_SKILL_COMMAND='agent-cli run-skill generate-rag-docs \
  --repo-root "$REPO_ROOT" \
  --changed-files "$RAG_DOCS_CHANGED_FILES_FILE" \
  --staged-files "$RAG_DOCS_STAGED_FILES_FILE" \
  --output-dir "$RAG_DOCS_OUTPUT_DIR"'

# Необязательное переопределение:
# RAG_DOCS_RELEVANT_PATH_REGEX='^(src/main/(kotlin|java)/.*\.(kt|java)|src/main/resources/.*\.(bpmn|dmn)|src/main/resources/application.*\.ya?ml|build\.gradle\.kts|settings\.gradle\.kts|pom\.xml|docs/rag-config/|rag-docs-config/|\.rag-docs-hook\.env)$'
